{
  "name": "growth-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "desktop:dev": "electron desktop/main.cjs",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "vue-tsc --noEmit",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:design": "playwright test --config playwright.design.config.ts",
    "cy:open": "cypress open --e2e",
    "cy:run": "cypress run --spec \"cypress/e2e/town/town-model.cy.ts,cypress/e2e/town/town-hud.cy.ts,cypress/e2e/town/town-engine.cy.ts,cypress/e2e/town/immersive-shell.cy.ts\"",
    "cy:gaps": "cypress run --spec cypress/e2e/town/town-gaps.cy.ts",
    "test:cy": "start-server-and-test dev http://localhost:5173 cy:run"
  },
  "dependencies": {
    "@rive-app/canvas": "^2.39.1",
    "echarts": "^6.0.0",
    "lucide-vue-next": "^0.468.0",
    "phaser": "^3.90.0",
    "pinia": "^3.0.3",
    "vue": "~3.5.40",
    "vue-router": "^4.5.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.10.3",
    "cypress": "^16.0.0",
    "electron": "^37.10.3",
    "jsdom": "^26.1.0",
    "start-server-and-test": "^3.0.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.4"
  }
}

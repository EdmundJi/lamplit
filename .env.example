# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:8080/api/v1
VITE_API_BASE_URL=/api/v1
SERVER_PORT=8080

# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=growth
MYSQL_USER=growth_app
MYSQL_PASSWORD=local-growth-password
MYSQL_ROOT_PASSWORD=local-root-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=local-redis-password

# Local object storage
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=local-storage-user
MINIO_ROOT_PASSWORD=local-storage-password
MINIO_KMS_SECRET_KEY=growth-local-kms:replace-with-a-base64-encoded-32-byte-key
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=growth-local
OBJECT_STORAGE_ACCESS_KEY=local-storage-user
OBJECT_STORAGE_SECRET_KEY=local-storage-password
OBJECT_STORAGE_PROVIDER=s3

# Primary model provider (DeepSeek). QWEN_* still works as a fallback name for this same slot - see
# docs/05-notes.md for why: it has always pointed at DeepSeek, DEEPSEEK_* is just the honest name.
DEEPSEEK_PROVIDER=mock
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-with-a-restricted-test-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=PT120S
DEEPSEEK_STREAM_TIMEOUT=PT130S
# Set to false for OpenAI-compatible gateways that do not implement response_format
DEEPSEEK_JSON_MODE=true

# Second provider for the companion town only (decision/turn/summary calls) - see RoutingResidentMind.
# qwen3.8-flash via DashScope's OpenAI-compatible endpoint. Leave blank to keep the town on deepseek
# alone; RoutingResidentMind fails over automatically when this is unset or the provider errors.
QWEN3_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN3_API_KEY=
QWEN3_MODEL=qwen3.8-flash

# Model "thinking" on/off, per call type, applied to whichever provider serves that call (see
# QwenProvider.StructuredPrompt / RoutingResidentMind - each provider translates this into its own
# wire field). Measured, not assumed (docs/05-notes.md): off is a large latency/token win on BOTH
# providers for decision-shaped calls, hence the default. turn/summary default to unset ("" = no
# override, provider's own default) because disabling thinking on creative/in-character text is
# untested for either provider - do not flip these without evidence it does not hurt quality.
COMPANION_MODEL_THINKING_DECISION=false
COMPANION_MODEL_THINKING_TURN=
COMPANION_MODEL_THINKING_SUMMARY=

# Which provider answers each call type, in try-order - the first entry is the default, later entries
# are the failover path if an earlier provider throws (see RoutingResidentMind). Decision defaults to
# qwen3 first per the "Qwen as primary" request; turn/summary stay on deepseek first (unchanged
# default) until dialogue quality with thinking off has actually been measured.
COMPANION_MODEL_ROUTE_DECISION=qwen3,deepseek
COMPANION_MODEL_ROUTE_TURN=deepseek,qwen3
COMPANION_MODEL_ROUTE_SUMMARY=deepseek,qwen3

# Authentication and retention
JWT_SECRET=replace-with-at-least-32-random-bytes
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
ACCESS_TOKEN_TTL=PT30M
REFRESH_TOKEN_TTL=P7D
PASSWORD_RESET_TOKEN_TTL=PT30M
AI_RETENTION_DAYS=30

# Disabled outside a local Spring profile even if these values are set.
LOCAL_ADMIN_LOGIN_ENABLED=false
LOCAL_ADMIN_LOGIN_USERNAME=
LOCAL_ADMIN_LOGIN_PASSWORD=

# First administrator bootstrap.
# Set these only once before the first production start. The app creates the admin
# only when no active ADMIN exists; remove these values after the account is created.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_DISPLAY_NAME=系统管理员
ADMIN_BOOTSTRAP_TIMEZONE=Asia/Shanghai
ADMIN_BOOTSTRAP_MFA_SECRET=

# --- 共享开发服务器（deploy/compose.dev.yaml / scripts/dev-server.sh）---
# 前后端都跑在容器里、源码挂进去热重载。端口与本机自己跑的 pnpm dev / spring-boot:run 冲突时改这里。
DEV_WEB_PORT=5173
DEV_API_PORT=8080
DEV_DEBUG_PORT=5005
DEV_LOGS_PORT=9999
# 值里有空格和 *，必须加引号：compose 读得懂裸值，但 scripts/dev-server.sh 用 bash source 读同一个文件，
# 不加引号 */5 会被当成通配符展开。
# 开发环境让小镇的两个夜间 job 跑勤一点；两个都按 (用户, 当地日期) 幂等，跑多少次都不会重复累加。
DEV_TOWN_REFLECTION_CRON="0 */5 * * * *"
DEV_TOWN_SOCIETY_CRON="0 */5 * * * *"
